<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_whatsapp"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingTop="22dp"
        android:paddingRight="18dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="WhatsThat"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Notification history"
                    android:textColor="#CDEDE3"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/countText"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <EditText
            android:id="@+id/searchBox"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_header_search"
            android:drawableLeft="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:hint="Search messages"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#D5EEE8"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/accessBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="14dp"
        android:background="@drawable/bg_access_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/latestText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/brand_text"
            android:textSize="13sp" />

        <Button
            android:id="@+id/openBtn"
            android:layout_width="112dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_primary"
            android:backgroundTint="@null"
            android:minHeight="0dp"
            android:text="Enable"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:paddingLeft="14dp"
        android:paddingTop="12dp"
        android:paddingRight="14dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/modeBtn"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_chip_selected"
                android:backgroundTint="@null"
                android:drawableLeft="@drawable/ic_chat"
                android:drawablePadding="8dp"
                android:minHeight="0dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="WhatsApp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/exportBtn"
                android:layout_width="44dp"
                android:layout_height="38dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_chip"
                android:backgroundTint="@null"
                android:contentDescription="Export"
                android:minHeight="0dp"
                android:padding="9dp"
                android:scaleType="center"
                android:src="@drawable/ic_export" />

            <ImageButton
                android:id="@+id/clearBtn"
                android:layout_width="44dp"
                android:layout_height="38dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_chip"
                android:backgroundTint="@null"
                android:contentDescription="Clear"
                android:minHeight="0dp"
                android:padding="9dp"
                android:scaleType="center"
                android:src="@drawable/ic_delete" />

            <ImageButton
                android:id="@+id/settingsBtn"
                android:layout_width="44dp"
                android:layout_height="38dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_chip"
                android:backgroundTint="@null"
                android:contentDescription="Settings"
                android:minHeight="0dp"
                android:padding="9dp"
                android:scaleType="center"
                android:src="@drawable/ic_settings" />

            <Spinner
                android:id="@+id/retentionSpinner"
                android:layout_width="158dp"
                android:layout_height="38dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_chip"
                android:entries="@array/retention_options"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/privacyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="14dp"
        android:text="Tap WhatsApp to switch inboxes. Long-press a row for cleanup actions."
        android:textColor="@color/brand_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="22dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:padding="26dp"
        android:text="No messages yet.\nEnable notification access and new WhatsApp alerts will appear like chats."
        android:textColor="@color/brand_muted"
        android:textSize="14sp" />

    <ListView
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:cacheColorHint="@android:color/transparent"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:listSelector="@android:color/transparent"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingBottom="12dp" />

</LinearLayout>
