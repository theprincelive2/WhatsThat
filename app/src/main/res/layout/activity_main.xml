<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F8FAFC">

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:background="@drawable/premium_header">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WhatsThat" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="32sp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WhatsApp Message Vault" android:textColor="#DBEAFE" android:textSize="15sp"/>
<TextView android:id="@+id/countText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="20sp"/>
</LinearLayout>

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp">
<Button android:id="@+id/openBtn" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="Enable"/>
<Button android:id="@+id/clearBtn" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_marginStart="12dp" android:text="Clear"/>
</LinearLayout>

<EditText android:id="@+id/searchBox" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginLeft="16dp" android:layout_marginRight="16dp" android:hint="Search WhatsApp messages" android:padding="14dp" android:background="@drawable/search_box_bg"/>

<TextView android:id="@+id/emptyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" android:gravity="center" android:text="No WhatsApp messages yet." android:textColor="#64748B"/>

<ListView android:id="@+id/listView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="12dp" android:dividerHeight="16dp"/>

</LinearLayout>