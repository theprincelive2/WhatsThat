<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_whatsapp"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingTop="22dp"
        android:paddingRight="18dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="WhatsThat"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Notification history"
                    android:textColor="#CDEDE3"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/countText"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <EditText
            android:id="@+id/searchBox"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_header_search"
            android:drawableLeft="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:hint="Search messages"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#D5EEE8"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/accessBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="14dp"
        android:background="@drawable/bg_access_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/latestText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/brand_text"
            android:textSize="13sp" />

        <Button
            android:id="@+id/openBtn"
            android:layout_width="112dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_primary"
            android:backgroundTint="@null"
            android:minHeight="0dp"
            android:text="Enable"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="14dp"
        android:background="@drawable/bg_top_status_card"
        android:orientation="vertical"
        android:paddingLeft="14dp"
        android:paddingTop="14dp"
        android:paddingRight="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CURRENT VIEW"
                    android:textColor="@color/brand_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/topViewTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="WhatsApp"
                    android:textColor="@color/brand_ink"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/topViewDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Clean view is hiding system notices"
                    android:textColor="@color/brand_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/modeBtn"
                android:layout_width="104dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_chip_selected"
                android:backgroundTint="@null"
                android:minHeight="0dp"
                android:text="Switch"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="86dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_top_status_fill" />

            <View
                android:layout_width="86dp"
                android:layout_height="8dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_top_status_track" />

            <View
                android:layout_width="86dp"
                android:layout_height="8dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_top_status_track" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/filterBtn"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:backgroundTint="@null"
                android:minHeight="0dp"
                android:text="Clean On"
                android:textAllCaps="false"
                android:textColor="@color/brand_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/blockedRulesBtn"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:backgroundTint="@null"
                android:minHeight="0dp"
                android:text="Blocked"
                android:textAllCaps="false"
                android:textColor="@color/brand_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/selectionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="14dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/deleteSelectedBtn"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:backgroundTint="@null"
            android:minHeight="0dp"
            android:text="Delete"
            android:textAllCaps="false"
            android:textColor="@color/brand_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/readSelectedBtn"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:backgroundTint="@null"
            android:minHeight="0dp"
            android:text="Read"
            android:textAllCaps="false"
            android:textColor="@color/brand_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/hideSelectedBtn"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:backgroundTint="@null"
            android:minHeight="0dp"
            android:text="Hide"
            android:textAllCaps="false"
            android:textColor="@color/brand_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/clearSelectionBtn"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:backgroundTint="@null"
            android:minHeight="0dp"
            android:text="Clear"
            android:textAllCaps="false"
            android:textColor="@color/brand_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/privacyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="14dp"
        android:text="Clean view hides system notices. Long-press a row for cleanup actions."
        android:textColor="@color/brand_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="22dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:padding="26dp"
        android:text="No messages yet.\nEnable notification access and new WhatsApp alerts will appear like chats."
        android:textColor="@color/brand_muted"
        android:textSize="14sp" />

    <ListView
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:cacheColorHint="@android:color/transparent"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:listSelector="@android:color/transparent"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="14dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_bottom_nav"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <Button
            android:id="@+id/statusSaverBtn"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_item"
            android:backgroundTint="@null"
            android:contentDescription="Status Saver"
            android:drawableTop="@drawable/ic_status"
            android:drawablePadding="4dp"
            android:minHeight="0dp"
            android:paddingTop="7dp"
            android:text="Status"
            android:textAllCaps="false"
            android:textColor="@color/brand_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/exportBtn"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_item"
            android:backgroundTint="@null"
            android:contentDescription="Export"
            android:drawableTop="@drawable/ic_export"
            android:drawablePadding="4dp"
            android:minHeight="0dp"
            android:paddingTop="7dp"
            android:text="Export"
            android:textAllCaps="false"
            android:textColor="@color/brand_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/importBtn"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_item"
            android:backgroundTint="@null"
            android:contentDescription="Import"
            android:drawableTop="@drawable/ic_import"
            android:drawablePadding="4dp"
            android:minHeight="0dp"
            android:paddingTop="7dp"
            android:text="Import"
            android:textAllCaps="false"
            android:textColor="@color/brand_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/clearBtn"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_item"
            android:backgroundTint="@null"
            android:contentDescription="Clear"
            android:drawableTop="@drawable/ic_delete"
            android:drawablePadding="4dp"
            android:minHeight="0dp"
            android:paddingTop="7dp"
            android:text="Clear"
            android:textAllCaps="false"
            android:textColor="@color/brand_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/settingsBtn"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_item"
            android:backgroundTint="@null"
            android:contentDescription="Settings"
            android:drawableTop="@drawable/ic_settings"
            android:drawablePadding="4dp"
            android:minHeight="0dp"
            android:paddingTop="7dp"
            android:text="Settings"
            android:textAllCaps="false"
            android:textColor="@color/brand_text"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
